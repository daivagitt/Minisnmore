<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260522092000-1" author="cursor">
        <addColumn tableName="customer_order">
            <column name="inventory_reserved" type="boolean"/>
            <column name="inventory_reserved_until" type="${datetimeType}"/>
            <column name="inventory_released_at" type="${datetimeType}"/>
        </addColumn>
        <createIndex tableName="customer_order" indexName="idx_customer_order__inventory_reservation">
            <column name="inventory_reserved"/>
            <column name="inventory_reserved_until"/>
            <column name="payment_status"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
