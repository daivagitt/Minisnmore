<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261008120000-1" author="miniandmore">
        <createTable tableName="package_box">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(80)">
                <constraints nullable="false" unique="true" uniqueConstraintName="ux_package_box_name"/>
            </column>
            <column name="length_cm" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="breadth_cm" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="height_cm" type="integer">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
