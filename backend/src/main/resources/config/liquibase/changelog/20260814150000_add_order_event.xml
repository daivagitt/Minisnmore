<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260814150000-1" author="miniandmore">
        <createTable tableName="order_event">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_login" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="order_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="order_number" type="varchar(40)">
                <constraints nullable="false"/>
            </column>
            <column name="event_type" type="varchar(40)">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="varchar(120)">
                <constraints nullable="false"/>
            </column>
            <column name="body" type="varchar(500)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint
            tableName="order_event"
            columnNames="order_id, event_type"
            constraintName="ux_order_event__order_id_event_type"/>
        <createIndex indexName="idx_order_event_user_login_created_at" tableName="order_event">
            <column name="user_login"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
