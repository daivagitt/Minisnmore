    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260602154500-1" author="codex">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="zoho_setting"/>
                <not>
                    <columnExists tableName="zoho_setting" columnName="pull_products_auto_create_category"/>
