<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <changeSet id="20260901120000-1" author="minisandmore">
        <addColumn tableName="site_setting">
            <column name="store_discount_percent" type="decimal(5,2)" defaultValueNumeric="20.00">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <sql dbms="postgresql">
            UPDATE site_setting
            SET store_discount_percent = COALESCE(store_discount_percent, 20.00);
        </sql>
    </changeSet>
</databaseChangeLog>
