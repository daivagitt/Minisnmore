{
  "info": {
    "name": "Minis n More API \u2014 Smoke (public 2xx only)",
    "description": "Runnable without auth. Only public GET storefront APIs that should return 2xx on UAT.\n\nRun entire collection in Postman Runner \u2014 no login required.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://minisnmore.com"
    },
    {
      "key": "productSlug",
      "value": "12"
    },
    {
      "key": "blogSlug",
      "value": "sample-slug"
    }
  ],
  "item": [
    {
      "name": "Storefront (public GET)",
      "item": [
        {
          "name": "GET banners",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', () => pm.expect(pm.response.code).to.be.oneOf([200,201,202,204]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/banners"
          }
        },
        {
