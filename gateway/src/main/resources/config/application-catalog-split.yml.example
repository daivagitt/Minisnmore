# Example gateway routes AFTER catalog is split into store + commerce + core.
# Copy predicates into application.yml (dev) and Consul central config (prod).
# More specific routes must appear BEFORE the catch-all store route.

spring:
  cloud:
    gateway:
      server:
        webflux:
          routes:
            - id: miniandmore-ledgerly-api
              uri: lb://miniandmore-store
              predicates:
                - Path=/api/v1/admin/ledgerly/**
              metadata:
                response-timeout: 120000
                connect-timeout: 5000
            - id: miniandmore-commerce-api
              uri: lb://miniandmore-commerce
              predicates:
                - Path=/api/v1/orders/**,/api/v1/account/**,/api/v1/payments,/api/v1/coupons/**,/api/v1/order-returns/**,/api/v1/admin/order-returns/**,/api/v1/admin/dashboard
              metadata:
                response-timeout: 120000
                connect-timeout: 5000
            - id: miniandmore-store-api
              uri: lb://miniandmore-store
              predicates:
                - Path=/api/v1/**
              metadata:
                response-timeout: 120000
                connect-timeout: 5000
