    {
      "name": "account",
      "item": [
        {
          "name": "POST /api/register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const seed = pm.environment.get('workerSeed') || pm.collectionVariables.get('workerSeed') || '0';",
                  "const ts = Date.now();",
                  "const login = `perf${ts}${seed}`;",
                  "pm.variables.set('registerLogin', login);",
                  "pm.variables.set('registerEmail', `${login}@uat.test`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.expect(pm.response.code).to.eql(201));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{registerLogin}}\",\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"{{registerPassword}}\",\n  \"firstName\": \"Perf\",\n  \"lastName\": \"Test\",\n  \"langKey\": \"en\"\n}"
            },
            "url": "{{baseUrl}}/api/register"
          }
        }
      ]
    }
