# Copy to /etc/mini-and-more/uat.env on the UAT1 VPS (chmod 600).
# Never commit real secrets to Git.
# Jenkins deploy: REMOTE_APP_DIR=/var/www/uat1/mini_and_more

# --- Shared JWT (gateway + store + commerce + catalog core) ---
JHIPSTER_SECURITY_AUTHENTICATION_JWT_BASE64_SECRET=

# --- Internal S2S (store/commerce → catalog core) ---
INTERNAL_API_KEY=

# --- Consul (optional; gateway UAT profile uses direct localhost routes) ---
CONSUL_HOST=127.0.0.1
CONSUL_PORT=8500

# --- Gateway DB (users, OAuth) ---
SPRING_R2DBC_URL=r2dbc:postgresql://127.0.0.1:5433/gateway
SPRING_R2DBC_USERNAME=gateway
SPRING_R2DBC_PASSWORD=
SPRING_LIQUIBASE_URL=jdbc:postgresql://127.0.0.1:5433/gateway
SPRING_LIQUIBASE_USERNAME=gateway
SPRING_LIQUIBASE_PASSWORD=

# --- Shared catalog DB (core only; Liquibase on core) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/miniandmore
SPRING_DATASOURCE_USERNAME=miniandmore
SPRING_DATASOURCE_PASSWORD=

# --- Edge → core (Spring relaxed binding) ---
APPLICATION_CATALOG_BASE_URL=http://127.0.0.1:8084
# Ledgerly accounting integration (catalog core)
LEDGERLY_API_BASE_URL=https://lender.qualityoutsidethebox.org/api
LEDGERLY_API_TOKEN=
LEDGERLY_ORG_ID=
LEDGERLY_SYNC_PRODUCT_IMAGES=true
LEDGERLY_ORDER_RETRY_MS=300000
LEDGERLY_ORDER_TRACKING_MS=3600000

# --- Redis (catalog core) ---
JHIPSTER_CACHE_REDIS_SERVER=redis://127.0.0.1:6379

# --- Public URLs ---
JHIPSTER_MAIL_BASE_URL=https://uat.minisnmore.com
FRONTEND_AUTH_CALLBACK_URL=https://uat.minisnmore.com/auth/callback
CORS_ALLOWED_ORIGIN_PATTERNS=https://uat.minisnmore.com

# --- Registration (gateway) ---
# Emergency only: skip activation email and activate accounts immediately (e.g. SMTP outage).
# Leave false for normal activation-email flow.
REGISTER_AUTO_ACTIVATE=false

# --- Mail (gateway) ---
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=minisnmore123@gmail.com
SPRING_MAIL_PASSWORD=
# Sender shown on activation/reset emails (must match SPRING_MAIL_USERNAME for Gmail)
JHIPSTER_MAIL_FROM=minisnmore123@gmail.com

# --- Social login (gateway) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Commerce / core ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Cloudflare R2 (S3-compatible). Create token: R2 → Manage R2 API Tokens → Object Read & Write on bucket.
# Verify after deploy: deploy/scripts/uat-verify-r2-storage.sh
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
S3_KEY_PREFIX=uat

# --- JVM (optional) ---
JAVA_OPTS_CATALOG=-Xms512m -Xmx1024m -XX:+UseG1GC
JAVA_OPTS_GATEWAY=-Xms256m -Xmx768m -XX:+UseG1GC
JAVA_OPTS_STORE=-Xms256m -Xmx512m -XX:+UseG1GC
JAVA_OPTS_COMMERCE=-Xms256m -Xmx512m -XX:+UseG1GC

# --- Observability ---
LOG_JSON=true
PROMETHEUS_ENABLED=false
TRACING_SAMPLE_PROBABILITY=0.1
