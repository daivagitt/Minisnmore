# Copy to /etc/mini-and-more/prod.env on the production VPS (chmod 600).
# Shared by gateway, store, commerce, and catalog core.

JHIPSTER_SECURITY_AUTHENTICATION_JWT_BASE64_SECRET=

CONSUL_HOST=127.0.0.1
CONSUL_PORT=8500

SPRING_R2DBC_URL=r2dbc:postgresql://127.0.0.1:5432/gateway
SPRING_R2DBC_USERNAME=gateway_produser
SPRING_R2DBC_PASSWORD=
SPRING_LIQUIBASE_URL=jdbc:postgresql://127.0.0.1:5432/gateway
SPRING_LIQUIBASE_USERNAME=gateway_produser
SPRING_LIQUIBASE_PASSWORD=

SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/miniandmore_prod
SPRING_DATASOURCE_USERNAME=miniandmore_produser
SPRING_DATASOURCE_PASSWORD=

# Edge services → catalog core (Spring relaxed binding)
APPLICATION_CATALOG_BASE_URL=http://127.0.0.1:8084

# Ledgerly (catalog core)
LEDGERLY_API_BASE_URL=https://lender.qualityoutsidethebox.org/api
LEDGERLY_API_TOKEN=
LEDGERLY_ORG_ID=
LEDGERLY_WEBHOOK_SECRET=
# Optional schedulers (milliseconds)
LEDGERLY_ORDER_RETRY_MS=300000
LEDGERLY_ORDER_TRACKING_MS=3600000
LEDGERLY_INVENTORY_PULL_MS=3600000

# Zoho Books (catalog core — runs alongside Ledgerly)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ORG_ID=
ZOHO_DATA_CENTER=in
ZOHO_SYNC_PRODUCT_IMAGES=true
ZOHO_SYNC_PRODUCT_STOCK=true
ZOHO_PULL_PRODUCTS_AUTO_CREATE_CATEGORY=false
ZOHO_AUTO_SYNC_ENABLED=false
ZOHO_ORDER_RETRY_FIXED_DELAY_MS=600000
ZOHO_ORDER_TRACKING_FIXED_DELAY_MS=900000
ZOHO_OAUTH_HOMEPAGE_URL=https://minisnmore.com
ZOHO_OAUTH_REDIRECT_URI=https://minisnmore.com
ZOHO_OAUTH_ADMIN_REDIRECT_URI=https://minisnmore.com/admin/zoho
ZOHO_OAUTH_JAVASCRIPT_DOMAIN=https://minisnmore.com
ZOHO_OAUTH_JAVASCRIPT_DOMAIN_ALT=https://www.minisnmore.com

JHIPSTER_CACHE_REDIS_SERVER=redis://127.0.0.1:6379

JHIPSTER_MAIL_BASE_URL=https://minisnmore.com
FRONTEND_AUTH_CALLBACK_URL=https://minisnmore.com/auth/callback
CORS_ALLOWED_ORIGIN_PATTERNS=https://minisnmore.com,https://www.minisnmore.com

# Active provider: gmail (default) or zoho
SPRING_MAIL_PROVIDER=gmail

# Gmail SMTP
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
JHIPSTER_MAIL_FROM=

# Zoho SMTP (smtppro.zoho.com — TLS/STARTTLS on port 587)
ZOHO_MAIL_HOST=smtp.zoho.in
ZOHO_MAIL_PORT=587
ZOHO_MAIL_USERNAME=Care@minisnmore.com
ZOHO_MAIL_PASSWORD=
ZOHO_MAIL_FROM=Care@minisnmore.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
S3_KEY_PREFIX=prod

JAVA_OPTS_CATALOG=-Xms768m -Xmx1536m -XX:+UseG1GC -XX:MaxGCPauseMillis=200
JAVA_OPTS_GATEWAY=-Xms512m -Xmx1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200
JAVA_OPTS_STORE=-Xms256m -Xmx512m -XX:+UseG1GC
JAVA_OPTS_COMMERCE=-Xms256m -Xmx512m -XX:+UseG1GC

LOG_JSON=true
PROMETHEUS_ENABLED=true
TRACING_SAMPLE_PROBABILITY=0.05

SERVER_ADDRESS=127.0.0.1
# Regex for Spring Cloud Gateway forwarded-header trust (Nginx on same host)
GATEWAY_TRUSTED_PROXIES=127\\.0\\.0\\.1
